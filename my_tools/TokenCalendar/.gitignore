.env.*
.codex/
auth.json
config.toml
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*

# Local logs / copied terminal output
*.log
*.log.*
*.out

# Local systemd unit generated from the public example
systemd/token-calendar-collect.service

# Shareable screenshots should be reviewed/redacted before publishing
token-calendar-screenshot.*
screenshots/
